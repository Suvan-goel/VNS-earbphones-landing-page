# Public site URL (used for metadata, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=https://trycymba.com
# Public contact address shown in the footer, FAQ and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=support@trycymba.com

# --- Waitlist storage (server-only; never prefix with NEXT_PUBLIC_) ---
# With both set, signups and survey answers are stored in Supabase.
# Without them local development uses demonstration mode; production returns 503.
# Partial Supabase configuration is always treated as unavailable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role JWT supported as a fallback when SECRET_KEY is unset:
# SUPABASE_SERVICE_ROLE_KEY=

# Local development only: store signups in .data/*.json instead.
# WAITLIST_STORAGE=file

# --- Reservations (server-only) ---
# Refundable deposit (£35 for the UK, US$50 for the US; see src/config/pricing.ts). Disabled by default.
# For isolated local Stripe testing, use npm run dev:reservations (see README).
# That launcher supplies test credentials and forces local storage; do not edit .env.local.
# Live checkout requires a separate explicit launch and production Supabase storage.
RESERVATIONS_ENABLED=false
# Prefer a restricted key with Checkout, PaymentIntent, Charge and Refund permissions needed
# by the integration. Use an isolated Stripe sandbox while developing; never a public variable.
STRIPE_SECRET_KEY=
# Stripe.js inline checkout uses this account's matching publishable key (pk_test_ or pk_live_).
# Keep it as server configuration; the reservation page passes it to the browser when needed.
# The local launcher supplies the sandbox profile's pk_test_ key automatically.
STRIPE_PUBLISHABLE_KEY=
# Mandatory. Endpoint: https://trycymba.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Local sandbox switch is set by the launcher; never use on a hosted server:
# RESERVATIONS_LOCAL_TEST=true
# Local visual demonstration only, without contacting Stripe:
# RESERVATIONS_PREVIEW=true
# WAITLIST_STORAGE=file
# Explicitly clear SUPABASE_URL and SUPABASE_SECRET_KEY for an isolated preview.

# --- Contact form delivery (server-only) ---
# Set a verified Resend sender; messages
# always go to support@trycymba.com. Missing configuration returns an error.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=

# Customer service emails. Apply 20261029_reservation_emails.sql before enabling.
# Use a verified trycymba.com sender, e.g. cymba <reservations@trycymba.com>.
# Shares RESEND_API_KEY with the contact form. Only live production events send.
RESERVATION_EMAILS_ENABLED=false
RESERVATION_EMAIL_FROM=
# Dedicated scheduler authentication; production value also lives in Supabase Vault.
RESERVATION_EMAIL_CRON_SECRET=

# --- Analytics ---
# Ask for consent before sending any analytics events (default true).
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true
# First-party event endpoint. Set to "none" to disable sending events.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=/api/events

# --- Meta advertising measurement (public build-time configuration) ---
# Leave blank to disable the Pixel. Loading also requires explicit marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=
# Opt in per deployment; Meta's dataset/category restrictions still apply.
# Even when true, Lead requires a confirmed new signup and current marketing consent.
NEXT_PUBLIC_META_LEAD_TRACKING_ENABLED=false
# Purchase events require a verified paid deposit and current marketing consent.
NEXT_PUBLIC_META_PURCHASE_TRACKING_ENABLED=false

# Signed Resend delivery/bounce callbacks (server only).
RESEND_WEBHOOK_SECRET=
