# Public site URL (used for metadata, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com
# Public contact address shown in the footer, FAQ and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Waitlist storage (server-only; never prefix with NEXT_PUBLIC_) ---
# With both set, signups and survey answers are stored in Supabase.
# Without them the form runs in clearly labelled demonstration mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: store signups in .data/*.json instead.
# WAITLIST_STORAGE=file

# --- Analytics ---
# Ask for consent before sending any analytics events (default true).
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true
# First-party event endpoint. Set to "none" to disable sending events.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=/api/events
